# Supabase — used by both the worship app backend and Vocal Hero
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_KEY=your-service-role-key-here

# Vocal Hero Python pipeline (optional — only needed for YouTube import)
PIPELINE_URL=https://your-pipeline-server.com
PIPELINE_SECRET=your-pipeline-secret

# Roster → Google Calendar push-sync (instant duty invites, see
# migrations/2026-07-18_add_calendar_sync_events.sql and app/api/calendar-sync)
# Owned by a DEDICATED Google account (not a real member's personal account) so
# no one who receives duty invites also sees the full roster as the calendar owner.
GOOGLE_CLIENT_ID=your-oauth-client-id
GOOGLE_CLIENT_SECRET=your-oauth-client-secret
GOOGLE_REFRESH_TOKEN=your-long-lived-refresh-token
GOOGLE_CALENDAR_ID=your-dedicated-calendar-id@group.calendar.google.com
#
# The same three credentials also drive /api/slide-page-ids, which reads the
# per-slide ids of a pasted Google Slides deck so it can be projected one slide
# at a time instead of as a single un-navigable embed. That needs a scope the
# calendar consent does not include, so add
#   https://www.googleapis.com/auth/presentations.readonly
# when minting GOOGLE_REFRESH_TOKEN (drive.readonly also works). Without it the
# route answers 403 saying exactly that, and a pasted deck falls back to the
# single embed — nothing else breaks. An API key cannot be used instead: the
# Slides API refuses them ("API keys are not supported by this API").
#
# Optional — protects the /api/calendar-reconcile GET (cron) path only
CRON_SECRET=a-random-secret-string

# Bible passage lookups (app/api/bible-passage) — optional. Without this,
# passage lookups fall back to the free bible-api.com WEB translation, which
# needs no key at all. Get a free key at https://api.esv.org/account/ for ESV.
ESV_API_KEY=your-esv-api-key

# AI-assisted lectionary reading extraction (app/api/parse-lectionary) --
# reads an uploaded bulletin PDF/Word/Excel (or a link to one) and asks
# Gemini to identify the 4 lectionary readings for that date. Without this,
# the "Auto-Fill from Bulletin" button shows a clear "not configured" error;
# the existing manual per-slot Bible Browser picker still works unchanged.
# Free key, no paid plan needed: https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key
