# Supabase — used by both the worship app backend and Vocal Hero
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_KEY=your-service-role-key-here

# Vocal Hero Python pipeline (optional — only needed for YouTube import)
PIPELINE_URL=https://your-pipeline-server.com
PIPELINE_SECRET=your-pipeline-secret

# Roster → Google Calendar push-sync (instant duty invites, see
# migrations/2026-07-18_add_calendar_sync_events.sql and app/api/calendar-sync)
# Owned by a DEDICATED Google account (not a real member's personal account) so
# no one who receives duty invites also sees the full roster as the calendar owner.
GOOGLE_CLIENT_ID=your-oauth-client-id
GOOGLE_CLIENT_SECRET=your-oauth-client-secret
GOOGLE_REFRESH_TOKEN=your-long-lived-refresh-token
GOOGLE_CALENDAR_ID=your-dedicated-calendar-id@group.calendar.google.com
#
# The same CLIENT also drives the Google Slides half of LCD Projection:
#   /api/slide-page-ids        reads a deck's per-slide ids, so it can be
#                              projected one slide at a time instead of as a
#                              single un-navigable embed;
#   /api/convert-pptx-to-slides  turns an uploaded .pptx into a Google Slides
#                              deck, which is what lets it play WITH its
#                              animations and with no third-party chrome.
#
# Those need scopes the calendar consent does not include:
#   https://www.googleapis.com/auth/presentations.readonly   (to read)
#   https://www.googleapis.com/auth/drive.file               (to convert)
#
# Put them in a token of their OWN, below. Do NOT add them when minting
# GOOGLE_REFRESH_TOKEN: a consent replaces whichever token it is minted into,
# so re-consenting the shared one takes roster calendar sync down with it --
# which is exactly what happened once. getSlidesAccessToken() prefers this
# variable and falls back to the calendar token only if it is unset.
GOOGLE_SLIDES_REFRESH_TOKEN=your-slides-refresh-token
#
# Without it, /api/convert-pptx-to-slides reports that it is not configured and
# every .pptx import falls back to CloudConvert -> PDF -> images, which works
# and simply cannot animate. Nothing is broken while it is unset.
#
# An API key cannot be used instead: the Slides API refuses them
# ("API keys are not supported by this API").
#
# NOTE on the consent screen: an app in *Testing* issues refresh tokens that
# die after 7 days. The project was published on 2026-08-16; the proof is
# `refresh_token_expires_in` being ABSENT from the token response, not what
# the console says.
#
# Optional — protects the /api/calendar-reconcile GET (cron) path only
CRON_SECRET=a-random-secret-string

# Bible passage lookups (app/api/bible-passage) — optional. Without this,
# passage lookups fall back to the free bible-api.com WEB translation, which
# needs no key at all. Get a free key at https://api.esv.org/account/ for ESV.
ESV_API_KEY=your-esv-api-key

# AI-assisted lectionary reading extraction (app/api/parse-lectionary) --
# reads an uploaded bulletin PDF/Word/Excel (or a link to one) and asks
# Gemini to identify the 4 lectionary readings for that date. Without this,
# the "Auto-Fill from Bulletin" button shows a clear "not configured" error;
# the existing manual per-slot Bible Browser picker still works unchanged.
# Free key, no paid plan needed: https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key
